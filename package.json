{
    "name":  "dsh-session-manager",
    "version":  "0.2.7",
    "packageManager":  "pnpm@11.7.0",
    "description":  "Session management plugin for DeepSeek Harness: visual import and delete of agent session copies.",
    "type":  "module",
    "main":  "plugin/index.mjs",
    "exports":  {
                    ".":  "./plugin/index.mjs",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-slots",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ],
                               "platform":  "web"
                           },
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "files":  [
                  "lib/",
                  "plugin/",
                  "src/",
                  "scripts/",
                  "assets/",
                  "README.md",
                  "LICENSE",
                  "CHANGELOG.md",
                  "cordis.patch.yml"
              ],
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "import":  "node import.mjs",
                    "export":  "node export.mjs"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "\u003e=0.1.0",
                             "@deepseek-ai/dsh-commands":  "\u003e=0.1.0-rc.0",
                             "@deepseek-ai/dsh-session":  "\u003e=0.1.0-rc.0",
                             "@deepseek-ai/dsh-session-persistence":  "\u003e=0.1.0-rc.0",
                             "@deepseek-ai/dsh-user-questions":  "\u003e=0.1.0-rc.0"
                         },
    "devDependencies":  {
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.4",
                            "esbuild":  "^0.28.2",
                            "jsdom":  "^30.0.1",
                            "react":  "^19.2.8",
                            "react-dom":  "^19.2.8",
                            "vitest":  "^4.1.10"
                        }
}
